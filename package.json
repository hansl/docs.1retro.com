{
  "name": "docs.1retro.com",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "astro dev",
    "prebuild": "npm run lint",
    "build": "astro build",
    "preview": "astro preview",
    "conformance": "node scripts/build-conformance.js",
    "prettier": "prettier .claude .do conformance scripts src test \"*.md\" \"*.mjs\" \"*.json\" .prettierrc .markdownlint-cli2.jsonc",
    "format": "npm run --silent prettier -- --write",
    "lint": "npm run --silent prettier -- --check && markdownlint-cli2",
    "test": "node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.39.3",
    "astro": "^6.3.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "3.9.6",
    "remark-code-import": "^1.2.0",
    "sharp": "^0.34.5",
    "starlight-links-validator": "^0.24.0"
  },
  "dependencies": {
    "starlight-theme-rapide": "^0.5.2"
  }
}
