{
  // Structural Markdown linting for the docs repo.
  // Formatting belongs to Prettier; this only checks what a formatter cannot.
  // Prose rules a generic linter cannot express (voice) are manual; see STYLE.md.
  "config": {
    "default": true,
    // Prettier wraps prose at 120, but will not break a table row or a long
    // URL, so those lines run over on purpose and length is not linted.
    "MD013": false,
    // Prettier aligns table pipes on every run, so the linter need not ask.
    "MD060": false,
  },
  // `.mdx` is intentionally excluded: it contains JSX that this linter cannot
  // parse. The prose checker covers `.mdx` instead.
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "dist", ".astro"],
}
