{
  "name": "cddl",
  "scopeName": "source.cddl",
  "fileTypes": ["cddl"],
  "patterns": [
    {
      "name": "comment.line.semicolon.cddl",
      "match": ";.*$"
    },
    {
      "name": "string.quoted.double.cddl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cddl",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.cddl",
      "match": "(?:h|b64)?'[^']*'"
    },
    {
      "match": "^\\s*([A-Za-z@_$][A-Za-z0-9\\-_@.$]*)(?=\\s*(?:\\/\\/?)?=(?!>))",
      "captures": {
        "1": {
          "name": "entity.name.function.cddl"
        }
      }
    },
    {
      "name": "keyword.control.cddl",
      "match": "\\.(size|bits|regexp|cbor|cborseq|within|and|lt|le|gt|ge|eq|ne|default|abnf|abnfb|feature)\\b"
    },
    {
      "name": "support.type.cddl",
      "match": "\\b(any|uint|nint|integer|int|bstr|bytes|tstr|text|tdate|time|number|biguint|bignint|bigint|unsigned|decfrac|bigfloat|encoded-cbor|uri|b64url|b64legacy|regexp|mime-message|cbor-any|float16-32|float32-64|float16|float32|float64|float)\\b"
    },
    {
      "name": "constant.language.cddl",
      "match": "\\b(true|false|nil|null|undefined)\\b"
    },
    {
      "name": "constant.numeric.tag.cddl",
      "match": "#\\d+(\\.\\d+)?|#"
    },
    {
      "name": "constant.numeric.cddl",
      "match": "\\b0x[0-9a-fA-F]+\\b|\\b0b[01]+\\b|\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.map.cddl",
      "match": "=>"
    },
    {
      "name": "keyword.operator.assignment.cddl",
      "match": "\\/\\/=|\\/=|="
    },
    {
      "name": "keyword.operator.choice.cddl",
      "match": "\\/\\/|\\/"
    },
    {
      "name": "keyword.operator.range.cddl",
      "match": "\\.\\.\\.?"
    },
    {
      "name": "keyword.operator.occurrence.cddl",
      "match": "[?+*]"
    },
    {
      "name": "punctuation.section.cddl",
      "match": "[{}\\[\\]()<>,:]"
    }
  ]
}
